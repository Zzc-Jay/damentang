{
  "permissions": {
    "allow": [
      "PowerShell(New-Item *)",
      "PowerShell(Invoke-Item *)",
      "Bash(timeout 5 curl -s -o /dev/null -w \"%{http_code} %{time_total}s\" https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng)",
      "Bash(timeout 5 curl -s -o /dev/null -w \"%{http_code} %{time_total}s\" https://fonts.gstatic.com)",
      "Bash(mkdir -p fonts)",
      "Bash(curl -L -s -o fonts/MaShanZheng.woff2 \"https://cdn.jsdelivr.net/npm/@canvas-fonts/mashanzheng@1.0.0/MaShanZheng.woff2\" -w \"%{http_code} %{size_download}bytes %{time_total}s\")",
      "Bash(curl -s \"https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng\")",
      "Bash(curl -L -s -o MaShanZheng.ttf \"https://raw.githubusercontent.com/googlefonts/noto-cjk/main/NotoSansCJKsc-VF.otf.ttf\" -w \"%{http_code}\" --connect-timeout 5)",
      "Bash(curl -L -s -o MaShanZheng.ttf \"https://cdn.bootcdn.net/ajax/libs/ma-shan-zheng/1.0.0/MaShanZheng.ttf\" -w \" bootcdn=%{http_code}\" --connect-timeout 5)",
      "Bash(curl -L -s -o /dev/null \"https://registry.npmmirror.com/@canvas-fonts/mashanzheng/-/mashanzheng-1.0.0.tgz\" -w \" npmmirror=%{http_code}\" --connect-timeout 5)",
      "Bash(grep -i \"\\\\.mp3$\\\\|\\\\.wav$\\\\|\\\\.ogg$\\\\|\\\\.webm$\")"
    ]
  }
}
